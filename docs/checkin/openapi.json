{
  "openapi": "3.1.0",
  "info": {
    "title": "TDEV check-in",
    "version": "0.1.0"
  },
  "paths": {
    "/api/checkin/health": {
      "get": {
        "tags": [
          "checkin"
        ],
        "summary": "Health",
        "description": "Database and pool status. No authentication, no sensitive data.",
        "operationId": "health_api_checkin_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/checkin/scan": {
      "post": {
        "tags": [
          "checkin"
        ],
        "summary": "Scan",
        "description": "Online scan of one QR: verify, apply the station rule, consume atomically, journal.",
        "operationId": "scan_api_checkin_scan_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScanRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/checkin/sync": {
      "post": {
        "tags": [
          "checkin"
        ],
        "summary": "Sync",
        "description": "Batch of offline scans: one status per operation, idempotent, order-independent conflicts.",
        "operationId": "sync_api_checkin_sync_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/checkin/conflicts": {
      "get": {
        "tags": [
          "checkin"
        ],
        "summary": "Conflicts",
        "description": "Conflicts of an event, newest first (supervisor).",
        "operationId": "conflicts_api_checkin_conflicts_get",
        "parameters": [
          {
            "name": "event_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "title": "Event Id"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(open|acknowledged)$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 40
                },
                {
                  "type": "null"
                }
              ],
              "title": "Type"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "default": 100,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/checkin/conflicts/{conflict_id}/acknowledge": {
      "post": {
        "tags": [
          "checkin"
        ],
        "summary": "Acknowledge",
        "description": "Supervisor acknowledges a conflict. Idempotent: the first resolver and note are kept.",
        "operationId": "acknowledge_api_checkin_conflicts__conflict_id__acknowledge_post",
        "parameters": [
          {
            "name": "conflict_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Conflict Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcknowledgeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/checkin/stats": {
      "get": {
        "tags": [
          "checkin"
        ],
        "summary": "Stats",
        "description": "Live counters per station, conflicts and terminals (no personal data).",
        "operationId": "stats_api_checkin_stats_get",
        "parameters": [
          {
            "name": "event_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "title": "Event Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/checkin/snapshot": {
      "get": {
        "tags": [
          "checkin"
        ],
        "summary": "Snapshot",
        "description": "Versioned entitlements for the offline cache (delta with ``since_version``, ETag, gzip).",
        "operationId": "snapshot_api_checkin_snapshot_get",
        "parameters": [
          {
            "name": "event_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "title": "Event Id"
            }
          },
          {
            "name": "since_version",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Since Version"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 512
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 5000,
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/checkin/logs": {
      "get": {
        "tags": [
          "checkin"
        ],
        "summary": "Logs",
        "description": "Audit listing of every scan (supervisor). Never returns a QR or capability.",
        "operationId": "logs_api_checkin_logs_get",
        "parameters": [
          {
            "name": "event_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "title": "Event Id"
            }
          },
          {
            "name": "station",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 40
                },
                {
                  "type": "null"
                }
              ],
              "title": "Station"
            }
          },
          {
            "name": "ticket_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 64
                },
                {
                  "type": "null"
                }
              ],
              "title": "Ticket Id"
            }
          },
          {
            "name": "terminal_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Terminal Id"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Since"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 1,
              "default": 200,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AcknowledgeRequest": {
        "properties": {
          "note": {
            "type": "string",
            "maxLength": 1000,
            "title": "Note",
            "default": ""
          }
        },
        "type": "object",
        "title": "AcknowledgeRequest",
        "description": "Supervisor acknowledgement of a conflict."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ScanRequest": {
        "properties": {
          "event_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Event Id"
          },
          "terminal_id": {
            "type": "string",
            "format": "uuid",
            "title": "Terminal Id"
          },
          "station": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Station",
            "description": "EVENT_ENTRY, FOOD_ACCESS, ..."
          },
          "capability": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 1,
            "title": "Capability",
            "description": "QR content; never stored or logged"
          },
          "operation_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Operation Id",
            "description": "Idempotency key (recommended)"
          },
          "scanned_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scanned At"
          },
          "app_version": {
            "type": "string",
            "maxLength": 64,
            "title": "App Version",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "event_id",
          "terminal_id",
          "station",
          "capability"
        ],
        "title": "ScanRequest",
        "description": "Online scan of one QR presented at a station."
      },
      "ScanResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "accepted",
              "conflict",
              "already_processed"
            ],
            "title": "Status"
          },
          "server_decision": {
            "type": "string",
            "title": "Server Decision"
          },
          "reason": {
            "type": "string",
            "title": "Reason",
            "default": ""
          },
          "ticket_id": {
            "type": "string",
            "title": "Ticket Id",
            "default": ""
          },
          "serial": {
            "type": "string",
            "title": "Serial",
            "default": ""
          },
          "station": {
            "type": "string",
            "title": "Station"
          },
          "use_index": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Use Index"
          },
          "first_scanned_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Scanned At"
          },
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Operation Id"
          }
        },
        "type": "object",
        "required": [
          "status",
          "server_decision",
          "station",
          "operation_id"
        ],
        "title": "ScanResponse",
        "description": "Outcome of an online scan."
      },
      "SyncRequest": {
        "properties": {
          "event_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Event Id"
          },
          "terminal_id": {
            "type": "string",
            "format": "uuid",
            "title": "Terminal Id"
          },
          "batch_id": {
            "type": "string",
            "format": "uuid",
            "title": "Batch Id"
          },
          "device_sent_at": {
            "type": "string",
            "format": "date-time",
            "title": "Device Sent At"
          },
          "app_version": {
            "type": "string",
            "maxLength": 64,
            "title": "App Version",
            "default": ""
          },
          "pending_count": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Pending Count"
          },
          "operations": {
            "items": {},
            "type": "array",
            "title": "Operations",
            "description": "Validated one by one: a bad item never fails the batch"
          }
        },
        "type": "object",
        "required": [
          "event_id",
          "terminal_id",
          "batch_id",
          "device_sent_at",
          "operations"
        ],
        "title": "SyncRequest",
        "description": "Batch of offline operations."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
