# Copier vers .env puis lancer: billetterie-api migrate && billetterie-api serve
# Voir README.md sections Configuration et Migrations base de données

# PostgreSQL (obligatoire en prod; laisser vide pour SQLite seul + --demo)
CACKLE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# SQLite local (miroir + session; chemin relatif a backend-python/)
CACKLE_DB=./data/billetterie-local.db

CACKLE_KEY_PASSPHRASE=changez-moi-12-caracteres-min
CACKLE_BASE_URL=http://localhost:8080
CACKLE_ADDR=:8080

# Microservice paiement (voir docs/PAYMENT-SERVICE.md)
CACKLE_PAYMENT_SERVICE_URL=https://pay.internal.example
CACKLE_PAYMENT_SERVICE_API_KEY=
CACKLE_PAYMENT_WEBHOOK_SECRET=
CACKLE_PAYMENT_PROVIDER_NAME=community-pay
CACKLE_PAYMENT_SERVICE_TIMEOUT=30
CACKLE_PAYMENT_PROVIDERS=manual,community-pay

# SMTP (confirmations commande)
CACKLE_SMTP_HOST=smtp.example.com
CACKLE_SMTP_PORT=587
CACKLE_SMTP_USER=
CACKLE_SMTP_PASSWORD=
CACKLE_SMTP_FROM=billetterie@example.com
