{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	# HTML et repli SPA (/inscription/*, admin) : toujours revalider apres deploy
	@other not path /assets/*
	header @other Cache-Control "no-cache, must-revalidate"

	handle /assets/* {
		file_server
	}
	handle {
		try_files {path} /index.html
		file_server
	}
}
