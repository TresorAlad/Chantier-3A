{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	# HTML and other unhashed files: always revalidate so a deploy shows up at once
	@other not path /assets/*
	header @other Cache-Control "no-cache"

	handle /assets/* {
		file_server
	}
	handle {
		try_files {path} /index.html
		file_server
	}
}
