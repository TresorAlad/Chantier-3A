{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://chantier-3a.onrender.com/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://chantier-3a.onrender.com/media/:path*"
    },
    {
      "source": "/((?!api/|media/).*)",
      "destination": "/index.html"
    }
  ]
}
