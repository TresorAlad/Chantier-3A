# Copier vers .env : cp .env.example .env
# Puis : billetterie-api migrate && billetterie-api serve
# PostgreSQL obligatoire : CHANTIER3A_DATABASE_URL
# Docker : docker compose up --build (migrate au demarrage)

# --- Docker Compose ---
CHANTIER3A_HOST_PORT=8080
COMPOSE_PROFILES=local-db
# CHANTIER3A_DEMO=1  optionnel : coffre demo + paiements factices (--demo)
CHANTIER3A_DEMO=0
# CHANTIER3A_PUBLIC_SIGNUP=1  autoriser POST /api/auth/signup (defaut : off en prod, on en demo)
# CHANTIER3A_PUBLIC_SIGNUP=0
CHANTIER3A_DOCKER_BUILD_CONTEXT=.
CHANTIER3A_DOCKERFILE=Dockerfile
CHANTIER3A_DOCKER_TARGET=runtime
# Avec UI (depot parent avec frontend/) :
# CHANTIER3A_DOCKER_BUILD_CONTEXT=..
# CHANTIER3A_DOCKERFILE=backend-python/Dockerfile
# CHANTIER3A_DOCKER_TARGET=with-ui

POSTGRES_USER=chantier3a
POSTGRES_PASSWORD=chantier3a
POSTGRES_DB=chantier3a

# --- Application (CLI + conteneur) ---
CHANTIER3A_DATABASE_URL=postgresql://chantier3a:chantier3a@db:5432/chantier3a?sslmode=disable
CHANTIER3A_DATA_DIR=./data
CHANTIER3A_KEY_PASSPHRASE=changez-moi-12-caracteres-min
CHANTIER3A_BASE_URL=http://localhost:8080
CHANTIER3A_ADDR=:8080

CHANTIER3A_PAYMENT_SERVICE_URL=
CHANTIER3A_PAYMENT_SERVICE_API_KEY=
CHANTIER3A_PAYMENT_WEBHOOK_SECRET=
CHANTIER3A_PAYMENT_PROVIDER_NAME=community-pay
CHANTIER3A_PAYMENT_SERVICE_TIMEOUT=30
CHANTIER3A_PAYMENT_PROVIDERS=manual

CHANTIER3A_SMTP_HOST=
CHANTIER3A_SMTP_PORT=587
CHANTIER3A_SMTP_USER=
CHANTIER3A_SMTP_PASSWORD=
CHANTIER3A_SMTP_FROM=
