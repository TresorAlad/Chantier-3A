# Copier vers .env : cp .env.example .env
# Puis : billetterie-api migrate && billetterie-api serve
# PostgreSQL obligatoire : CHANTIER3A_DATABASE_URL
# Docker : docker compose up --build (migrate au demarrage)
# Render : voir docs/RENDER.md et render.yaml a la racine du depot (PORT auto, disque /srv/data)

# --- Docker Compose ---
CHANTIER3A_HOST_PORT=8080
COMPOSE_PROFILES=local-db
# CHANTIER3A_DEMO=1  optionnel : coffre demo + paiements factices (--demo)
CHANTIER3A_DEMO=0
# CHANTIER3A_PUBLIC_SIGNUP=1  autoriser POST /api/auth/signup (defaut : off en prod, on en demo)
# CHANTIER3A_PUBLIC_SIGNUP=0
CHANTIER3A_DOCKER_BUILD_CONTEXT=.
CHANTIER3A_DOCKERFILE=Dockerfile
CHANTIER3A_DOCKER_TARGET=runtime
# Avec UI (depot parent avec frontend/) :
# CHANTIER3A_DOCKER_BUILD_CONTEXT=..
# CHANTIER3A_DOCKERFILE=backend-python/Dockerfile
# CHANTIER3A_DOCKER_TARGET=with-ui

POSTGRES_USER=chantier3a
POSTGRES_PASSWORD=chantier3a
POSTGRES_DB=chantier3a

# --- Application (CLI + conteneur) ---
CHANTIER3A_DATABASE_URL=postgresql://chantier3a:chantier3a@db:5432/chantier3a?sslmode=disable
CHANTIER3A_DATA_DIR=./data
CHANTIER3A_KEY_PASSPHRASE=changez-moi-12-caracteres-min
CHANTIER3A_BASE_URL=http://localhost:8080
CHANTIER3A_ADDR=:8080

CHANTIER3A_PAYMENT_SERVICE_URL=
CHANTIER3A_PAYMENT_SERVICE_API_KEY=
CHANTIER3A_PAYMENT_WEBHOOK_SECRET=
CHANTIER3A_PAYMENT_PROVIDER_NAME=community-pay
CHANTIER3A_PAYMENT_SERVICE_TIMEOUT=30
CHANTIER3A_PAYMENT_PROVIDERS=manual

# FedaPay (Checkout.js). Secret key: server only, never in frontend-web/.env.
# Webhook: https://<api>/api/payments/webhook/fedapay, event transaction.approved.
# To enable, set CHANTIER3A_PAYMENT_PROVIDERS=manual,fedapay
CHANTIER3A_FEDAPAY_SECRET_KEY=
CHANTIER3A_FEDAPAY_WEBHOOK_SECRET=
CHANTIER3A_FEDAPAY_ENV=sandbox

CHANTIER3A_SMTP_HOST=
CHANTIER3A_SMTP_PORT=587
CHANTIER3A_SMTP_USER=
CHANTIER3A_SMTP_PASSWORD=
CHANTIER3A_SMTP_FROM=

# JWT (login local et OAuth)
CHANTIER3A_SECRET_KEY=
CHANTIER3A_ALGORITHM=HS256
CHANTIER3A_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google OAuth2
CHANTIER3A_GOOGLE_CLIENT_ID=
CHANTIER3A_GOOGLE_CLIENT_SECRET=
CHANTIER3A_GOOGLE_REDIRECT_URI=
CHANTIER3A_OAUTH_STATE_SECRET=

# --- Check-in (module checkin/, voir docs/checkin/DESIGN.md) ---
# Base du module : par defaut CHANTIER3A_DATABASE_URL (ou la valeur de la config 3A en mode monte)
# CHECKIN_DATABASE_URL=
# Pool de connexions PAR PROCESSUS : connexions totales = workers x CHECKIN_DB_POOL_MAX
# CHECKIN_DB_POOL_MIN=2
# CHECKIN_DB_POOL_MAX=10
# Postes connus (les regles par billet sont dans la table checkin_station_rules)
# CHECKIN_STATIONS=EVENT_ENTRY,FOOD_ACCESS,MERCH_PICKUP,AFTER_ENTRY
# CHECKIN_SYNC_MAX_BATCH=500
# CHECKIN_SNAPSHOT_TTL_SECONDS=15
# CHECKIN_STATS_TTL_SECONDS=2
# Cache des cles publiques de l'evenement (une cle revoquee reste acceptee jusqu'a ce delai)
# CHECKIN_KEYS_TTL_SECONDS=30
# Cache authentification/roles (0 = desactive, le plus prudent : une session fermee reste valide ce delai)
# CHECKIN_AUTH_CACHE_SECONDS=0
# CHECKIN_LOCK_TIMEOUT_MS=2000
# CHECKIN_RATE_LIMIT_PER_TERMINAL=600
# Cle de signature du snapshot (SECRET, graine Ed25519 base64url). Generer : python -m checkin.signing
# Sans cle, le snapshot est servi non signe et l'app doit le refuser.
# CHECKIN_SNAPSHOT_SIGNING_KEY=
# Seuils d'horloge suspecte (valeurs par defaut prudentes, a valider)
# CHECKIN_CLOCK_OFFSET_MAX_SECONDS=300
# CHECKIN_CLOCK_FUTURE_TOLERANCE_SECONDS=60
# CHECKIN_MAX_OPERATION_AGE_HOURS=72
